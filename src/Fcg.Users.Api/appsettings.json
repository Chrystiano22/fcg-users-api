{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Service": {
    "Name": "UsersAPI"
  },
  "RabbitMq": {
    "Enabled": false,
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "ConnectionStrings": {
    "UsersDb": "Data Source=users.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=users.db"
  },
  "Jwt": {
    "Issuer": "fcg-users-api",
    "Audience": "fcg-services",
    "SecretKey": "development-secret-key-change-before-production",
    "ExpirationInMinutes": 60
  },
  "SeedData": {
    "Admin": {
      "Enabled": true,
      "Name": "FCG Admin",
      "Email": "admin@fcg.local",
      "Password": "Admin@123"
    }
  }
}
